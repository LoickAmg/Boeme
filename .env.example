# Sans DATABASE_URL, le développement local utilise une base embarquée (.pglite/),
# migrée et garnie de la bibliothèque au premier accès.
# En production : URL Postgres (Neon, via l'intégration Vercel qui la renseigne toute seule).
DATABASE_URL=

# Obligatoire en production : au moins 32 caractères aléatoires (sert à saler les empreintes anti-abus).
APP_SECRET=

# Adresse du compte administrateur (modération). Le premier compte créé avec cette adresse devient
# administrateur, une seule fois : les inscriptions suivantes avec la même adresse ne le deviennent pas.
ADMIN_EMAIL=

# Adresse publique du site (sitemap, liens canoniques). Sur Vercel, le domaine de production est détecté.
# SITE_URL=https://exemple.test

# Identité de l'éditeur (pages légales). Valeurs par défaut : celles de l'éditeur actuel.
# SITE_PUBLISHER=
# CONTACT_EMAIL=

# --- Générateur : LLM optionnel (tout fonctionne sans) ---------------------
# Laisser vide : le générateur maison (banques de mots) est utilisé, sans configuration.
# Renseigner une clé active le moteur LLM, avec repli automatique sur le générateur maison en cas d'échec.
POEM_LLM_API_KEY=
# POEM_LLM_API_URL=   (défaut : https://api.openai.com/v1/chat/completions, ou toute API compatible)
# POEM_LLM_MODEL=     (défaut : gpt-4o-mini)
# POEM_GLOBAL_HOURLY_LIMIT=300   (plafond de générations par heure)
