# Base de données Postgres — requise pour la galerie publique.
# En dev local : postgresql://user:password@localhost:5432/poem_generator
# En prod : fournie automatiquement par l'intégration Postgres de Vercel.
DATABASE_URL=

# --- LLM optionnel (facultatif, tout fonctionne sans) -----------------
# Laisser vide : le générateur maison (banques de mots) est utilisé par
# défaut, sans aucune configuration. Renseigner une clé active le moteur
# LLM, avec repli automatique sur le générateur maison en cas d'échec.
POEM_LLM_API_KEY=
# Optionnel — par défaut : https://api.openai.com/v1/chat/completions
# (accepte toute API compatible "chat completions", ex. Groq, OpenRouter, Together AI)
POEM_LLM_API_URL=
# Optionnel — par défaut : gpt-4o-mini
POEM_LLM_MODEL=
